# Source exported values in your shell; the gateway does not auto-load .env files.
# Required: generate locally with `uv run python -c 'import secrets; print(secrets.token_hex(32))'`.
# Empty intentionally: no shared signing secret is supplied.
GATEWAY_JWT_SECRET=
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:8001/mcp
GATEWAY_TIMEOUT_SECONDS=5

# Streaming guardrail: local synthetic provider, no credentials required.
STREAM_UPSTREAM_URL=http://127.0.0.1:8011/v1/chat/completions
STREAM_READ_TIMEOUT_SECONDS=5
STREAM_TOTAL_TIMEOUT_SECONDS=30
STREAM_MAX_REQUEST_BYTES=65536
STREAM_MAX_EVENT_BYTES=65536
STREAM_MAX_PENDING_CHARS=256
MOCK_STREAM_DELAY_SECONDS=0.02
MOCK_STREAM_TEXT_CHARS=5
MOCK_STREAM_WIRE_BYTES=7

# Model router: one logical reservation, deterministic mock-token accounting.
# Required: comma-separated locally generated keys; never commit real keys.
# Generate each key with secrets.token_urlsafe(32). No shared default is supplied.
ROUTER_API_KEYS=
ROUTER_DB_PATH=model_router/usage.db
ROUTER_TOKEN_LIMIT=50000
ROUTER_WINDOW_MS=60000
ROUTER_DB_TIMEOUT_SECONDS=1
# Queue + execution deadline; capacity counts running and undrained queued jobs.
ROUTER_DB_OPERATION_TIMEOUT_SECONDS=2
ROUTER_DB_MAX_PENDING=16
ROUTER_PRIMARY_URL=http://127.0.0.1:8021/v1/chat/completions
ROUTER_BACKUP_URL=http://127.0.0.1:8022/v1/chat/completions
ROUTER_PRIMARY_MODEL=mock-primary
ROUTER_BACKUP_MODEL=mock-backup
ROUTER_PRIMARY_TIMEOUT_SECONDS=3
ROUTER_BACKUP_TIMEOUT_SECONDS=5
ROUTER_CLEANUP_TIMEOUT_SECONDS=1
ROUTER_REQUEST_TIMEOUT_SECONDS=5
ROUTER_MAX_REQUEST_BYTES=65536
ROUTER_MAX_RESPONSE_BYTES=65536
# Modes: ok, 429, timeout, late, trickle, malformed, error, overspent,
# missing_usage, bad_usage, hidden_usage. No live model is called.
ROUTER_MOCK_PRIMARY_MODE=ok
ROUTER_MOCK_BACKUP_MODE=ok
ROUTER_MOCK_DELAY_SECONDS=3.2
