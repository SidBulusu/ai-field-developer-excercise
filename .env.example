# Source exported values in your shell; the gateway does not auto-load .env files.
# Required: generate locally with `uv run python -c 'import secrets; print(secrets.token_hex(32))'`.
# Empty intentionally: no shared signing secret is supplied.
GATEWAY_JWT_SECRET=
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:8001/mcp
GATEWAY_TIMEOUT_SECONDS=5
